generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector]
}

// ─── Users ───────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  phone     String?
  profileImage String? @map("profile_image")
  address   String?
  birthday  String?
  notificationPrefs Json?    @map("notification_prefs") // push/email/sms preference toggles
  ref       String?  // signup source: "qr", "tiktok", "organic"

  // Account deletion is soft for a fixed grace period so an accidental or
  // coerced deletion is recoverable; `purgeAfter` is when the row becomes
  // eligible for irreversible removal.
  deletedAt      DateTime? @map("deleted_at")
  purgeAfter     DateTime? @map("purge_after")
  deletionReason String?   @map("deletion_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  isPremium  Boolean  @default(false) @map("is_premium")
  membershipTier String @default("green") @map("membership_tier")
  stripeCustomerId String? @unique @map("stripe_customer_id")

  hostProfile    HostProfile?
  valetProfile   ValetProfile?
  checkIns       CheckIn[]
  savedSpots     SavedSpot[]
  savedVehicles  Vehicle[]
  iosPushDevices      IOSPushDevice[]
  providerIdentities ProviderIdentity[]
  vendorSeats    VendorSeat[]
  collections    SpotCollection[]
  pointTxns      PointTransaction[]
  achievements   UserAchievement[]
  preference     UserPreference?
  followers      Follow[]          @relation("following") // users who follow me
  following      Follow[]          @relation("follower")  // users I follow
  reviews        Review[]
  tipsGiven      Tip[]             @relation("tipFrom")
  hostedParties  Party[]           @relation("partyHost")
  partyGuests    PartyGuest[]
  partyCheckouts PartyCheckout[]
  mobilityQuotes MobilityQuote[]
  mobilityTrips  MobilityTrip[]
  socialInvitesSent     SocialInvitation[]    @relation("socialInviteFrom")
  socialInvitesReceived SocialInvitation[]    @relation("socialInviteTo")
  contactHashes         ContactHash[]
  identityHashes        UserIdentityHash[]
  ownedCircles          SocialCircle[]
  circleMemberships     SocialCircleMember[]
  partyEncounterOptIns  PartyEncounterOptIn[]

  @@map("users")
}

// ─── iOS Push Devices ────────────────────────────────
enum IOSPushEnvironment {
  production
  sandbox
}

model IOSPushDevice {
  id            String             @id @default(cuid())
  token         String             @unique
  userId        String             @map("user_id")
  environment   IOSPushEnvironment
  bundleId      String             @map("bundle_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  lastSeenAt    DateTime           @default(now()) @map("last_seen_at")
  invalidatedAt DateTime?          @map("invalidated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, invalidatedAt])
  @@map("ios_push_devices")
}

// ─── Provider identities ─────────────────────────────
enum AuthProvider {
  apple
  google
}

model ProviderIdentity {
  id        String       @id @default(cuid())
  provider  AuthProvider
  subject   String
  userId    String       @map("user_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("provider_identities")
}

// ─── Venues ──────────────────────────────────────────
model Venue {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  address     String
  lat         Float
  lng         Float
  category    String   // "bar", "restaurant", "club", "park", "market"
  imageUrl    String?  @map("image_url")
  entryType   String   @default("free") @map("entry_type") // "free" or "paid"
  entryPrice  String?  @map("entry_price") // e.g. "$15", "$25–$50"
  ticketUrl   String?  @map("ticket_url") // external purchase link
  createdAt   DateTime @default(now()) @map("created_at")

  // PostGIS: geometry(Point, 4326) — populated from lat/lng
  // Managed via raw SQL; Prisma can't model geometry natively
  // Column: "location" geometry(Point, 4326)

  // pgvector: 384-dim embedding for AI similarity search
  // Column: "embedding" vector(384)

  crowdLevels CrowdLevel[]
  parking     ParkingSpot[]
  checkIns    CheckIn[]
  savedBy     SavedSpot[]
  reviews     Review[]
  mobilityQuotes MobilityQuote[]
  arrivalParties Party[] @relation("partyArrivalVenue")

  @@map("venues")
}

// ─── Crowd Levels (time-series) ──────────────────────
model CrowdLevel {
  id        String   @id @default(cuid())
  venueId   String   @map("venue_id")
  level     Int      // 1=chill, 2=moderate, 3=busy, 4=packed
  label     String   // "Chill", "Active", "Busy", "Packed"
  waitMins  Int?     @map("wait_mins")
  source    String   @default("manual") // "manual", "sensor", "user_report"
  recordedAt DateTime @default(now()) @map("recorded_at")

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, recordedAt(sort: Desc)])
  @@map("crowd_levels")
}

// ─── Parking ─────────────────────────────────────────
model ParkingSpot {
  id          String   @id @default(cuid())
  venueId     String   @map("venue_id")
  name        String   // "Lot A", "Street — 10th St"
  type        String   // "lot", "garage", "street"
  totalSpots  Int      @map("total_spots")
  available   Int
  pricePerHr  Float?   @map("price_per_hr")
  updatedAt   DateTime @updatedAt @map("updated_at")

  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("parking_spots")
}

// ─── Provider Profiles ───────────────────────────────
model HostProfile {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  status         String    @default("draft") // draft | pending | approved | rejected
  currentStep    Int       @default(1) @map("current_step")
  onboardingData Json?     @map("onboarding_data")
  /// Official Host identity. `handle` is the public @name; `hostDestinations`
  /// is an ordered list of { kind, value, primary? } where socials store
  /// handles (Bytspot resolves routing) and music/merch/website store HTTPS
  /// URLs that are never shown publicly. Parties snapshot at publish.
  handle           String?  @unique
  hostDestinations Json?    @map("host_destinations")
  submittedAt    DateTime? @map("submitted_at")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("host_profiles")
}

// ─── Host Studio Parties ────────────────────────────────
// Party media is deliberately bounded and stored in Postgres for the beta
// release. Move this to object storage/CDN before high-volume rollout.
model Party {
  id                     String       @id @default(cuid())
  hostUserId             String       @map("host_user_id")
  idempotencyKey         String       @map("idempotency_key")
  templateId             String       @map("template_id")
  title                  String
  tagline                String
  startsAt               DateTime     @map("starts_at")
  endsAt                 DateTime?    @map("ends_at")
  venueName              String       @map("venue_name")
  arrivalVenueId         String?      @map("arrival_venue_id")
  locationDisclosure     String       @default("public") @map("location_disclosure")
  capacity               Int
  accessMode             String       @map("access_mode")
  requiredMembershipTier String       @map("required_membership_tier")
  hostDestinations       Json?        @map("host_destinations")
  audienceCircleIds      String[]     @default([]) @map("audience_circle_ids")
  itinerary              Json
  ticketTiers            Json         @map("ticket_tiers")
  cohosts                Json
  templateConfig         Json         @map("template_config")
  status                 String       @default("draft")
  admissionPaused        Boolean      @default(false) @map("admission_paused")
  // Host override for when the share link stops resolving. Null means the
  // default policy: the link dies when the party ends (endsAt, falling back
  // to startsAt + 6h when the host set no end time).
  shareLinkExpiresAt     DateTime?    @map("share_link_expires_at")
  /// Set when the host closes the room. The party keeps `status = 'published'`
  /// so confirmed guests keep their passes and the guest and payment records
  /// that block deletion survive; closing only removes the room from the host
  /// console and stops new arrivals.
  closedAt               DateTime?    @map("closed_at")
  passCode               String?      @unique @map("pass_code")
  /// Platform fee in basis points, frozen at publish from the then-current
  /// PlatformFeeSetting. Null on drafts and on parties published before the
  /// fee existed; those fall back to the current rate at checkout.
  platformFeeBps         Int?         @map("platform_fee_bps")
  publishedAt            DateTime?    @map("published_at")
  /// Set when the host publishes the recap album. While null the recap is
  /// staged and host-only, and must stay indistinguishable from no recap.
  recapPublishedAt       DateTime?    @map("recap_published_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  host                   User         @relation("partyHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  arrivalVenue           Venue?       @relation("partyArrivalVenue", fields: [arrivalVenueId], references: [id], onDelete: Restrict)
  media                  PartyMedia[]
  guests                 PartyGuest[]
  checkouts              PartyCheckout[]
  encounterOptIns        PartyEncounterOptIn[]

  @@unique([hostUserId, idempotencyKey])
  @@index([hostUserId, status])
  @@index([status, startsAt])
  @@index([arrivalVenueId])
  @@map("parties")
}

// The platform's cut, adjustable at any time to steady the market. Rows are
// appended, never updated: the current rate is the newest row for a scope, and
// the history is the audit trail of what the rate was on any past date.
// A party snapshots the rate at publish, so changing it here never reprices a
// party whose host has already been shown a number.
model PlatformFeeSetting {
  id          String   @id @default(cuid())
  scope       String   @default("party-ticket")
  feeBps      Int      @map("fee_bps")
  note        String?
  setByUserId String?  @map("set_by_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([scope, createdAt(sort: Desc)])
  @@map("platform_fee_settings")
}

model PartyGuest {
  id                String   @id @default(cuid())
  partyId           String   @map("party_id")
  userId            String   @map("user_id")
  status            String   @default("pending")
  accessGranted     Boolean  @default(false) @map("access_granted")
  ticketTierName    String?  @map("ticket_tier_name")
  credential        String?  @unique
  checkedInAt       DateTime? @map("checked_in_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  party             Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkouts         PartyCheckout[]

  @@unique([partyId, userId])
  @@index([partyId, status])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("party_guests")
}

model PartyCheckout {
  id                    String   @id @default(cuid())
  partyId               String   @map("party_id")
  partyGuestId          String   @map("party_guest_id")
  userId                String   @map("user_id")
  idempotencyKey        String   @map("idempotency_key")
  stripeSessionId       String?  @unique @map("stripe_session_id")
  checkoutUrl           String?  @map("checkout_url")
  ticketTierName        String   @map("ticket_tier_name")
  amountCents           Int      @map("amount_cents")
  /// The split as it stood when this sale was made, recorded per checkout so a
  /// later rate change can never restate what a host already earned.
  platformFeeBps        Int?     @map("platform_fee_bps")
  platformFeeCents      Int?     @map("platform_fee_cents")
  hostNetCents          Int?     @map("host_net_cents")
  currency              String   @default("usd")
  status                String   @default("creating")
  reservationExpiresAt  DateTime @map("reservation_expires_at")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  party                 Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  guest                 PartyGuest @relation(fields: [partyGuestId], references: [id], onDelete: Cascade)
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId, idempotencyKey])
  @@index([partyId, ticketTierName, status, reservationExpiresAt])
  @@index([partyGuestId, updatedAt(sort: Desc)])
  @@map("party_checkouts")
}

// ─── Premium Mobility ───────────────────────────────────
// Quotes and handoffs are owned by the authenticated rider. A destination is
// always a registered Venue; clients cannot submit arbitrary drop-off points.
model MobilityQuote {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  venueId         String   @map("venue_id")
  provider        String
  providerQuoteId String?  @map("provider_quote_id")
  serviceClass    String   @map("service_class")
  serviceTitle    String   @map("service_title")
  priceLabel      String?  @map("price_label")
  etaLabel        String?  @map("eta_label")
  pickupLat       Float    @map("pickup_lat")
  pickupLng       Float    @map("pickup_lng")
  pickupLabel     String   @map("pickup_label")
  dropoffLabel    String   @map("dropoff_label")
  bookingMode     String   @default("handoff") @map("booking_mode")
  status          String   @default("ready")
  expiresAt       DateTime @map("expires_at")
  providerPayload Json?    @map("provider_payload")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Restrict)
  trip            MobilityTrip?

  @@index([userId, expiresAt])
  @@index([venueId, createdAt(sort: Desc)])
  @@map("mobility_quotes")
}

model MobilityTrip {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  quoteId               String   @unique @map("quote_id")
  idempotencyKey        String   @map("idempotency_key")
  provider              String
  providerReservationId String?  @map("provider_reservation_id")
  handoffUrl            String?  @map("handoff_url")
  status                String   @default("handoff_pending")
  cancellationReason    String?  @map("cancellation_reason")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote                 MobilityQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("mobility_trips")
}

model PartyMedia {
  id        String   @id @default(cuid())
  partyId   String   @map("party_id")
  kind      String
  position  Int      @default(0)
  mimeType  String   @map("mime_type")
  bytes     Bytes
  byteSize  Int      @map("byte_size")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, kind, position])
  @@index([partyId])
  @@map("party_media")
}

model ValetProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique @map("user_id")
  status              String    @default("draft") // draft | active | inactive | suspended
  agreementAcceptedAt DateTime? @map("agreement_accepted_at")
  profileData         Json?     @map("profile_data")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("valet_profiles")
}

// ─── Beta Waitlist Leads ─────────────────────────────
// Pre-registration email capture from bytspot.com funnel.
// Separate from User so it works before someone creates a password.
model BetaLead {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?                       // first name — for personalised welcome email
  source    String?                       // "bytspot.com", "qr", "tiktok", "organic"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("beta_leads")
}

// ─── Check-In History (per-user) ──────────────────────
model CheckIn {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  venueId       String   @map("venue_id")
  crowdLevel    Int      @map("crowd_level")
  crowdLabel    String   @map("crowd_label")
  pointsEarned  Int      @default(10) @map("points_earned")
  /// How the check-in was established: self_reported, nearby, or verified.
  /// Existing rows predate any proof and are self_reported by definition.
  proof         String   @default("self_reported")
  /// Metres from the venue at the moment of the tap, when the device offered
  /// a coordinate. Null means unknown, which is not the same as far.
  distanceM     Int?     @map("distance_m")
  createdAt     DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  /// The cooldown asks "has this member been paid here recently", and the
  /// answer is most often no — without this it scans the member's whole
  /// history to say so, worst exactly on a first visit.
  @@index([userId, venueId, createdAt(sort: Desc)])
  /// Crowd level counts the distinct members whose check-in at a venue carried
  /// proof, inside the recent window. 20260824_add_checkin_proof created this
  /// index; the model never declared it, so every CI run since has been red.
  @@index([venueId, proof, createdAt(sort: Desc)])
  @@index([venueId])
  @@map("check_ins")
}

// ─── Saved Spots ──────────────────────────────────────
model SavedSpot {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  venueId   String   @map("venue_id")
  notes     String?
  tags      String[] @default([])
  savedAt   DateTime @default(now()) @map("saved_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  items SpotCollectionItem[]

  @@unique([userId, venueId])
  @@index([userId])
  @@map("saved_spots")
}

// ─── Saved Vehicles ───────────────────────────────────
// Replaces users.vehicles. As a JSON array every mutation was a
// read-modify-write of the whole array, so concurrent adds lost one, and
// `v_${Date.now()}` ids collided within a millisecond — making `update` edit
// the wrong vehicle and `remove` delete two. Rows give each vehicle its own
// identity and its own write.
model Vehicle {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  type             String
  make             String
  model            String
  year             Int
  color            String
  licensePlate     String   @map("license_plate")
  photo            String?
  vin              String?
  transmissionType String   @map("transmission_type")
  trunkCategory    String   @map("trunk_category")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("vehicles")
}

// ─── Spot Collections ─────────────────────────────────
model SpotCollection {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SpotCollectionItem[]

  @@index([userId])
  @@map("spot_collections")
}

model SpotCollectionItem {
  id           String @id @default(cuid())
  collectionId String @map("collection_id")
  savedSpotId  String @map("saved_spot_id")

  collection SpotCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  savedSpot  SavedSpot      @relation(fields: [savedSpotId], references: [id], onDelete: Cascade)

  @@unique([collectionId, savedSpotId])
  @@map("spot_collection_items")
}

// ─── Points Ledger ────────────────────────────────────
model PointTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String   // "earn", "spend", "bonus"
  amount      Int
  description String
  category    String   // "checkin", "achievement", "referral", "review", "streak"
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("point_transactions")
}

// ─── Achievements ─────────────────────────────────────
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id") // e.g. "first_checkin", "night_owl_10"
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ─── User Preferences ─────────────────────────────────
model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  interests String[] @default([])
  vibes     String[] @default([])
  cuisines  String[] @default([])
  parking   Json?    // { covered, evCharging, security }
  behavior  Json?    // { categoryClicks, lastLocations, visitCounts }
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── Social: Follow Graph ─────────────────────────────
model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ─── Social: Connection Invitations ───────────────────
model SocialInvitation {
  id          String    @id @default(cuid())
  fromUserId  String    @map("from_user_id")
  toUserId    String    @map("to_user_id")
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  fromUser User @relation("socialInviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("socialInviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  // DB-only (see 20260814_add_social_graph): partial unique expression index
  // social_invitations_pair_active_key on (LEAST(from,to), GREATEST(from,to))
  // WHERE status IN ('pending','accepted') — one active invite per user pair.
  @@unique([fromUserId, toUserId])
  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@map("social_invitations")
}

// ─── Social: Privacy-preserving Contact Graph ─────────
// Only salted SHA-256 hashes of normalized contact identifiers are stored.
// Raw emails/phone numbers never reach the server (see the shared iOS
// `BytspotContactHasher` contract).
model ContactHash {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  hashedContact String   @map("hashed_contact")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hashedContact])
  @@index([hashedContact])
  @@map("contact_hashes")
}

// Salted SHA-256 hashes of each member's own auth-verified identifiers,
// maintained server-side so contact sync can surface "this contact is on
// Bytspot" without the other member syncing first. Currently only the
// signup email is hashed; `kind: 'phone'` is reserved and must not be
// written until a phone-verification flow proves ownership (unverified
// numbers would enable discovery impersonation).
// Same salt/normalization contract as ContactHash (`src/lib/contactHash.ts`).
model UserIdentityHash {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  hashedIdentity String   @map("hashed_identity")
  kind           String // email | phone
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hashedIdentity])
  @@index([hashedIdentity])
  @@map("user_identity_hashes")
}

// ─── Social: Circles ──────────────────────────────────
model SocialCircle {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  owner   User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members SocialCircleMember[]

  @@index([ownerId])
  @@map("social_circles")
}

model SocialCircleMember {
  id       String   @id @default(cuid())
  circleId String   @map("circle_id")
  userId   String   @map("user_id")
  addedAt  DateTime @default(now()) @map("added_at")

  circle SocialCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
  @@map("social_circle_members")
}

// ─── Social: People You Met (per-Party opt-in) ────────
// Attendee visibility is strictly double-opt-in and per Party. A row only
// records willingness to be discoverable; deleting it removes the user from
// every People You Met surface immediately.
model PartyEncounterOptIn {
  id        String   @id @default(cuid())
  partyId   String   @map("party_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
  @@index([userId])
  @@map("party_encounter_opt_ins")
}

// ─── Reviews ─────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  venueId   String   @map("venue_id")
  stars     Int      // 1-5
  vibe      Int      // 1-10
  comment   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId, createdAt(sort: Desc)])
  @@map("reviews")
}


// ─── Tips (Valet Tipping) ─────────────────────────────
model Tip {
  id                    String   @id @default(cuid())
  fromUserId            String   @map("from_user_id")
  toValetId             String   @map("to_valet_id")
  amount                Float
  stripePaymentIntentId String   @unique @map("stripe_payment_intent_id")
  createdAt             DateTime @default(now()) @map("created_at")

  fromUser User @relation("tipFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toValetId])
  @@map("tips")
}

// ─── Vendor console ──────────────────────────────────
// The vendor half of the marketplace: a business, the people who hold seats in
// it, the places it operates from, and the receivers it wants told about
// changes. Shapes mirror contracts/bookable-templates.json in bytspot-beta;
// the enums exist so an invalid state is a migration failure rather than a
// string nobody validated.

enum VendorSellerState {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VendorBusinessMode {
  standard
  cottage
}

enum VendorSeatRole {
  owner
  manager
  staff
  door
  serviceProvider
}

enum VendorSeatState {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum VendorLocationState {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum VendorPayoutStatus {
  pending
  active
  restricted
}

enum VendorEndpointState {
  ACTIVE
  PAUSED
  DISABLED
}

/// A business. Identity only; what it sells lives on its bookables.
///
/// There is deliberately no `satisfied` column. Which requirements a seller has
/// met is derived from these records on every read, because a stored list is a
/// claim that goes stale the moment a location is paused — and a stale tick
/// tells a vendor they are live when they are not.
model VendorSeller {
  id           String             @id @default(cuid())
  legalName    String?            @map("legal_name")
  contactEmail String?            @map("contact_email")
  state        VendorSellerState  @default(DRAFT)
  businessMode VendorBusinessMode @default(standard) @map("business_mode")

  /// The processor's account reference and the status it decided. Never written
  /// by us and never a bank detail: the hosted flow collects those. `last4` is
  /// display text the processor handed back, not a fragment we derived.
  payoutReference String?             @map("payout_reference")
  payoutStatus    VendorPayoutStatus? @map("payout_status")
  payoutLast4     String?             @map("payout_last4")
  payoutDetail    String?             @map("payout_detail")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seats     VendorSeat[]
  locations VendorLocation[]
  endpoints VendorWebhookEndpoint[]

  @@index([state])
  @@map("vendor_sellers")
}

/// One person's seat in one business. Identity is the existing User, because a
/// person who books a table and a person who runs the restaurant are the same
/// person and must not be two accounts.
model VendorSeat {
  id       String          @id @default(cuid())
  sellerId String          @map("seller_id")
  userId   String          @map("user_id")
  role     VendorSeatRole
  state    VendorSeatState @default(INVITED)

  /// Consulted only for an assigned-scope role. Postgres arrays rather than
  /// join tables: an empty list must mean nothing rather than everything, and
  /// bookables have no table yet to point a foreign key at.
  locationIds String[] @map("location_ids")
  bookableIds String[] @map("bookable_ids")

  invitedAt DateTime? @map("invited_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  seller    VendorSeller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoints VendorWebhookEndpoint[]

  /// One seat per person per business, so an invite cannot silently duplicate
  /// a seat someone already holds.
  @@unique([sellerId, userId])
  /// Sign-in reads every seat a person holds, in one query.
  @@index([userId, state])
  @@index([sellerId, state])
  @@map("vendor_seats")
}

/// A PIN a seller holds. The same PIN the guest is sent to.
model VendorLocation {
  id       String              @id @default(cuid())
  sellerId String              @map("seller_id")
  label    String
  kind     String
  state    VendorLocationState @default(DRAFT)

  /// Absent only for a visiting provider, who publishes no address.
  address String?
  lat     Float
  lng     Float
  /// Only meaningful when the vendor is the one travelling.
  radiusMiles Float?  @map("radius_miles")
  timezone    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller VendorSeller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// Every profile read filters a seller's places by state.
  @@index([sellerId, state])
  @@map("vendor_locations")
}

/// A registered receiver. It carries the seat that created it rather than its
/// own permission list, so revoking a seat silences its endpoints without
/// anyone remembering to go and delete them.
model VendorWebhookEndpoint {
  id       String              @id @default(cuid())
  sellerId String              @map("seller_id")
  seatId   String              @map("seat_id")
  url      String
  scopes   String[]
  state    VendorEndpointState @default(ACTIVE)

  /// Encrypted, not hashed: the sender has to reproduce the HMAC, so it needs
  /// the secret back. Must never be selected into a list response — only the
  /// sender reads this column.
  secretEncrypted String @map("secret_encrypted")

  /// Consecutive, so one success anywhere resets it. A flaky receiver should be
  /// disabled for being down, not for being flaky.
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastDeliveryAt      DateTime? @map("last_delivery_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seller     VendorSeller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  seat       VendorSeat                @relation(fields: [seatId], references: [id], onDelete: Cascade)
  deliveries VendorWebhookDelivery[]

  @@index([sellerId])
  @@index([seatId])
  @@map("vendor_webhook_endpoints")
}

/// The delivery queue, durable on purpose. Held in memory it would lose every
/// pending retry on deploy, and a webhook that vanishes on restart is worse
/// than one that never existed: the receiver has no way to know it was owed.
model VendorWebhookDelivery {
  id         String @id @default(cuid())
  endpointId String @map("endpoint_id")
  eventId    String @map("event_id")
  event      String
  body       String

  attempt       Int      @default(0)
  nextAttemptAt DateTime @map("next_attempt_at")

  createdAt DateTime @default(now()) @map("created_at")

  endpoint VendorWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  /// The dedupe key. A retry reuses the event id; a genuinely new event never
  /// does, so this also stops a double-enqueue becoming a double-delivery.
  @@unique([endpointId, eventId])
  /// The sender's only query: what is due now, oldest first.
  @@index([nextAttemptAt])
  @@map("vendor_webhook_deliveries")
}
