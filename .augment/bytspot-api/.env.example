# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bytspot?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# CORS — comma-separated allowed origins
# The vendor console is a separate origin and sends credentials, so it must be
# listed here explicitly — a wildcard is not permitted with credentials.
CORS_ORIGINS="http://localhost:3000,https://bytspot.com,https://vendor.bytspot.app"

# Apple Push Notification service (leave empty in local development)
# APNS_KEY_PATH must point to a deployed P8 key file; never put key contents in this file.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_KEY_PATH=""
APNS_BUNDLE_ID="com.bytspot.app"
APNS_ENVIRONMENT="production"

# OpenID Connect audiences — identifiers only, never provider credentials.
# APPLE_CLIENT_ID is the native app's Apple client identifier.
# GOOGLE_SERVER_CLIENT_ID is the web/server OAuth client ID used as the Google ID-token audience.
APPLE_CLIENT_ID=""
GOOGLE_SERVER_CLIENT_ID=""

# Transactional email. Required for vendor sign-in: without it /vendor/auth/code
# answers 503 rather than returning a cheerful 200 for a code nobody receives.
RESEND_API_KEY=""

# Keys the vendor sign-in code hashes under. Sign-in refuses to run without
# Redis: an auth store in process memory resets on deploy and lets each
# instance disagree about how many attempts a code has had.
CONTACT_HASH_SALT=""
